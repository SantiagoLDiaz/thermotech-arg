---
// src/pages/trabajos.astro
const WSP_NUMBER = "5493364660047";
const WSP_MESSAGE = encodeURIComponent("¡Hola Thermotech Arg! Quisiera consultar por un presupuesto o trabajo similar a los de la galería.");

// Lista de rutas de imágenes del portfolio (.jpeg)
const GALERIA_FOTOS = [
  "/images/proyectos/trabajo-1.jpeg",
  "/images/proyectos/trabajo-2.jpeg",
  "/images/proyectos/trabajo-3.jpeg",
  "/images/proyectos/trabajo-4.jpeg",
  "/images/proyectos/trabajo-5.jpeg",
  "/images/proyectos/trabajo-6.jpeg",
  "/images/proyectos/trabajo-7.jpeg",
  "/images/proyectos/trabajo-8.jpeg"
];
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Galería de Trabajos | Thermotech Arg</title>
  <meta name="description" content="Galería fotográfica de montajes, mantenimientos e intervenciones técnicas realizadas por Thermotech Arg." />
  
  <!-- Favicon Oficial Thermotech Arg -->
  <link rel="icon" type="image/jpeg" href="/favicon.jpeg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <script is:inline src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#0B132B] text-[#F3F3F5] font-['Montserrat',sans-serif] antialiased min-h-screen selection:bg-[#00B4D8] selection:text-white">

  <!-- Encabezado con Botón Volver -->
  <header class="sticky top-0 z-50 bg-[#0B132B]/95 backdrop-blur-xl border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
      <!-- Logo Marca Oficial -->
      <a href="#" class="flex items-center gap-2.5 shrink-0 group">
        <img 
          src="/images/logoth.jpeg" 
          alt="Thermotech Arg" 
          class="h-10 sm:h-12 w-auto object-contain rounded-lg transition-transform group-hover:scale-105"
        />
      </a>

      <a href="/" class="text-xs font-semibold text-zinc-300 hover:text-[#00B4D8] transition flex items-center gap-1.5 border border-white/10 px-3.5 py-2 rounded-lg bg-white/5">
        <span>← Volver al Inicio</span>
      </a>
    </div>
  </header>

  <main class="py-12 sm:py-16 px-4 max-w-7xl mx-auto">
    <!-- Título de la Galería -->
    <div class="text-center mb-10 sm:mb-14 space-y-2">
      <span class="text-xs uppercase tracking-[0.2em] font-bold text-[#00B4D8]">Experiencia en Campo</span>
      <h1 class="text-3xl sm:text-5xl font-black uppercase text-white tracking-tight">
        Galería de <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00B4D8] to-[#90E0EF]">Trabajos Realizados</span>
      </h1>
    </div>

    <!-- Grilla Masonry Adaptable (Se ajusta al alto natural de cada foto) -->
    <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6 mb-16">
      {GALERIA_FOTOS.map((src, idx) => (
        <div class="break-inside-avoid rounded-2xl overflow-hidden bg-white/5 border border-white/10 shadow-lg hover:border-[#00B4D8]/50 transition-all duration-300 group">
          <img 
            src={src} 
            alt={`Trabajo realizado ${idx + 1}`}
            class="w-full h-auto object-cover group-hover:scale-102 transition-transform duration-300 block"
            loading="lazy"
            onerror={`this.onerror=null; this.src='https://via.placeholder.com/600x450/1C2541/00B4D8?text=Trabajo+${idx + 1}';`}
          />
        </div>
      ))}
    </div>

    <!-- Llamada a la Acción de Cierre -->
    <div class="bg-gradient-to-r from-[#1C2541] to-[#0B132B] p-8 rounded-3xl border border-white/10 text-center space-y-4 max-w-3xl mx-auto">
      <h2 class="text-xl sm:text-2xl font-black uppercase text-white">¿Necesita un servicio o instalación similar?</h2>
      <p class="text-xs text-zinc-300">Coordinamos visitas técnicas y cotizaciones en menos de 24 horas.</p>
      <a href={`https://wa.me/${WSP_NUMBER}?text=${WSP_MESSAGE}`} target="_blank" class="inline-flex items-center gap-2.5 bg-gradient-to-r from-green-500 to-emerald-600 hover:brightness-110 text-white font-extrabold text-xs uppercase tracking-widest px-8 py-4 rounded-xl transition shadow-[0_0_20px_rgba(34,197,94,0.3)]">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.892 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
        <span>Consultar por WhatsApp</span>
      </a>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-[#070A13] py-8 border-t border-white/5 text-center text-[11px] text-zinc-500 px-4">
    <p>THERMOTECH ARG - San Nicolás de los Arroyos, Buenos Aires</p>
  </footer>
</body>
</html>