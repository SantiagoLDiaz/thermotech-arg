---
// src/pages/index.astro
const WSP_NUMBER = "5493364660047"; 
const WSP_MESSAGE = encodeURIComponent("¡Hola Thermotech Arg! Quisiera solicitar información / presupuesto para un servicio técnico.");

const COMPANY_INFO = {
  name: "Thermotech Arg",
  location: "San Nicolás de los Arroyos, Buenos Aires",
  services: [
    { title: "Cámaras Frigoríficas", desc: "Instalación, diagnóstico y mantenimiento de cámaras frigoríficas industriales y comerciales." },
    { title: "Vitrinas y Expositores", desc: "Equipos de frío comercial de alta eficiencia energética para resguardo de productos." },
    { title: "Mantenimiento Preventivo", desc: "Planes periódicos orientados a reducir paradas inesperadas y optimizar el consumo eléctrico." },
    { title: "Climatización y Electricidad", desc: "Atención técnica en aire acondicionado convencionales e Inverter, tableros y protecciones." }
  ]
};
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Thermotech Arg | Refrigeración Comercial e Industrial</title>
  <meta name="description" content="Servicios técnicos de refrigeración, climatización, electricidad y mantenimiento preventivo/correctivo para empresas e industrias." />
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Script CDN Tailwind -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#0B132B] text-[#F3F3F5] font-['Montserrat',sans-serif] antialiased min-h-screen selection:bg-[#00B4D8] selection:text-white overflow-x-hidden">

  <!-- Encabezado / Navegación -->
  <header class="sticky top-0 z-50 bg-[#0B132B]/95 backdrop-blur-xl border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex justify-between items-center">
      
      <!-- Logo Marca -->
      <a href="#" class="flex items-center gap-2.5 shrink-0">
        <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-[#00B4D8] to-[#0077B6] flex items-center justify-center font-black text-white text-base shadow-[0_0_15px_rgba(0,180,216,0.4)]">
          TH
        </div>
        <div class="flex flex-col">
          <span class="text-sm sm:text-base font-extrabold tracking-wider text-white uppercase leading-none">Thermotech Arg</span>
          <span class="text-[8px] sm:text-[9px] tracking-widest text-[#00B4D8] font-semibold uppercase mt-0.5">Refrigeración</span>
        </div>
      </a>

      <!-- Menú Desktop -->
      <nav class="hidden md:flex items-center gap-6 text-xs tracking-widest uppercase font-semibold text-zinc-300">
        <a href="#inicio" class="hover:text-[#00B4D8] transition">Inicio</a>
        <a href="#servicios" class="hover:text-[#00B4D8] transition">Servicios</a>
        <a href="#proceso" class="hover:text-[#00B4D8] transition">Metodología</a>
        <a href="#empresa" class="hover:text-[#00B4D8] transition">Normativa B2B</a>
        <a href="#contacto-directo" class="hover:text-[#00B4D8] transition">Contacto</a>
      </nav>

      <!-- Botón Solicitud WhatsApp -->
      <a href={`https://wa.me/${WSP_NUMBER}?text=${WSP_MESSAGE}`} target="_blank" class="bg-gradient-to-r from-[#00B4D8] to-[#0077B6] hover:brightness-110 text-white font-bold text-[10px] sm:text-xs tracking-wider uppercase px-4 sm:px-5 py-2 sm:py-2.5 rounded-full transition-all shadow-[0_0_15px_rgba(0,180,216,0.3)] flex items-center gap-1.5 shrink-0">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.892 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
        <span class="hidden xs:inline">Solicitar </span><span>Visita</span>
      </a>

    </div>
  </header>

  <!-- Hero Section Mejorado (Grilla 2 Columnas para PC) -->
  <section id="inicio" class="relative min-h-[85vh] flex items-center px-4 sm:px-6 lg:px-12 z-10 overflow-hidden bg-gradient-to-b from-[#0B132B] via-[#1C2541] to-[#0B132B] py-12 lg:py-16">
    <div class="max-w-7xl mx-auto w-full grid lg:grid-cols-12 gap-8 lg:gap-12 items-center relative z-20">
      
      <!-- Columna Izquierda: Texto e Invocación -->
      <div class="lg:col-span-7 space-y-5">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#00B4D8]/10 border border-[#00B4D8]/30 text-[#00B4D8] text-[10px] sm:text-xs font-bold uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-[#00B4D8] animate-ping shrink-0"></span>
          <span>Continuidad Operativa & Eficiencia Energética</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-black uppercase tracking-tight text-white leading-tight">
          Soluciones Integrales de <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00B4D8] via-[#90E0EF] to-[#0077B6]">Refrigeración Comercial e Industrial</span>
        </h1>

        <p class="text-xs sm:text-base text-zinc-300 font-light leading-relaxed max-w-2xl">
          Optimizamos sus instalaciones frigoríficas reduciendo el consumo eléctrico hasta un <strong>35%</strong>. Mantenimiento preventivo, correctivo e instalación profesional garantizada.
        </p>

        <div class="pt-3">
          <a href={`https://wa.me/${WSP_NUMBER}?text=${WSP_MESSAGE}`} target="_blank" class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-[#00B4D8] to-[#0077B6] hover:brightness-110 text-white font-extrabold px-8 py-4 rounded-xl text-xs uppercase tracking-widest transition-all shadow-[0_0_25px_rgba(0,180,216,0.4)] text-center w-full sm:w-auto">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.892 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
            <span>Cotizar Visita por WhatsApp</span>
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Tarjeta Visual que Llena el Espacio en PC -->
      <div class="lg:col-span-5 hidden lg:block">
        <div class="relative bg-white/5 border border-white/10 p-8 rounded-3xl backdrop-blur-xl shadow-2xl space-y-6">
          <div class="flex items-center justify-between border-b border-white/10 pb-4">
            <span class="text-xs uppercase tracking-widest font-bold text-[#00B4D8]">Rendimiento Garantizado</span>
            <span class="text-xs text-zinc-400">Respuesta &lt; 24hs</span>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="bg-white/5 p-4 rounded-2xl border border-white/5">
              <span class="text-3xl font-black text-[#00B4D8] block">35%</span>
              <span class="text-[11px] text-zinc-300 font-medium">Ahorro Energético Estimado</span>
            </div>
            <div class="bg-white/5 p-4 rounded-2xl border border-white/5">
              <span class="text-3xl font-black text-white block">24/7</span>
              <span class="text-[11px] text-zinc-300 font-medium">Asistencia Técnica Urgencias</span>
            </div>
          </div>

          <ul class="space-y-3 text-xs text-zinc-300">
            <li class="flex items-center gap-2.5">
              <span class="w-4 h-4 rounded-full bg-[#00B4D8]/20 text-[#00B4D8] flex items-center justify-center font-bold text-[10px]">✓</span>
              <span>Monitoreo y diagnóstico térmico integral</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="w-4 h-4 rounded-full bg-[#00B4D8]/20 text-[#00B4D8] flex items-center justify-center font-bold text-[10px]">✓</span>
              <span>Protección y resguardo de la cadena de frío</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="w-4 h-4 rounded-full bg-[#00B4D8]/20 text-[#00B4D8] flex items-center justify-center font-bold text-[10px]">✓</span>
              <span>Adecuación legal y normas de seguridad laboral</span>
            </li>
          </ul>
        </div>
      </div>

    </div>
  </section>

  <!-- Servicios -->
  <section id="servicios" class="py-16 sm:py-20 px-4 max-w-7xl mx-auto relative z-10">
    <div class="text-center mb-12 sm:mb-16 space-y-2">
      <span class="text-xs uppercase tracking-[0.2em] font-bold text-[#00B4D8]">Especialidades Técnicas</span>
      <h2 class="text-2xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tight text-white">Nuestras <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00B4D8] to-[#90E0EF]">Soluciones</span></h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {COMPANY_INFO.services.map((item, idx) => (
        <div class="group bg-white/5 p-6 sm:p-8 rounded-2xl border border-white/10 hover:border-[#00B4D8]/50 transition-all duration-300 backdrop-blur-md">
          <div class="w-10 h-10 rounded-xl bg-[#00B4D8]/10 border border-[#00B4D8]/30 flex items-center justify-center text-[#00B4D8] font-black text-lg mb-4">
            0{idx + 1}
          </div>
          <h3 class="text-base font-black uppercase text-white mb-2">{item.title}</h3>
          <p class="text-xs text-zinc-400 leading-relaxed font-light">{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Proceso -->
  <section id="proceso" class="py-16 sm:py-20 px-4 max-w-7xl mx-auto border-t border-white/5 relative z-10">
    <div class="text-center mb-12 sm:mb-16 space-y-2">
      <span class="text-xs uppercase tracking-[0.2em] font-bold text-[#00B4D8]">Garantía de Servicio</span>
      <h2 class="text-2xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tight text-white">Nuestro <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00B4D8] to-[#90E0EF]">Proceso</span></h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-white/5 p-6 sm:p-8 rounded-2xl border border-white/10">
        <span class="text-3xl sm:text-4xl font-black text-[#00B4D8] block mb-3">01</span>
        <h3 class="text-base font-bold uppercase text-white mb-2">Diagnóstico del Local</h3>
        <p class="text-xs text-zinc-400 leading-relaxed font-light">Evaluación detallada de condiciones operativas, carga térmica e instalaciones.</p>
      </div>

      <div class="bg-white/5 p-6 sm:p-8 rounded-2xl border border-white/10">
        <span class="text-3xl sm:text-4xl font-black text-[#00B4D8] block mb-3">02</span>
        <h3 class="text-base font-bold uppercase text-white mb-2">Diseño de la Solución</h3>
        <p class="text-xs text-zinc-400 leading-relaxed font-light">Selección precisa de equipos y distribución óptima ajustada al presupuesto.</p>
      </div>

      <div class="bg-white/5 p-6 sm:p-8 rounded-2xl border border-white/10">
        <span class="text-3xl sm:text-4xl font-black text-[#00B4D8] block mb-3">03</span>
        <h3 class="text-base font-bold uppercase text-white mb-2">Instalación y Soporte</h3>
        <p class="text-xs text-zinc-400 leading-relaxed font-light">Puesta en marcha con mínimas interrupciones comerciales y mantenimiento preventivo.</p>
      </div>
    </div>
  </section>

  <!-- B2B / Normativa -->
  <section id="empresa" class="py-16 px-4 max-w-7xl mx-auto border-t border-white/5 relative z-10">
    <div class="bg-gradient-to-r from-[#1C2541] to-[#0B132B] p-6 sm:p-12 rounded-3xl border border-white/10 grid lg:grid-cols-2 gap-8 items-center">
      <div>
        <span class="text-xs uppercase tracking-widest text-[#00B4D8] font-bold block mb-2">Estándares para Industria</span>
        <h3 class="text-xl sm:text-3xl font-black uppercase text-white mb-4">Compromiso, Seguridad y Calidad</h3>
        <p class="text-xs text-zinc-300 leading-relaxed mb-4">
          Cumplimos con estrictas normativas de seguridad e higiene laboral, EPP adaptados a plantas industriales y documentación legal completa para homologación de proveedores.
        </p>
        <ul class="space-y-2 text-xs text-zinc-300">
          <li class="flex items-center gap-2"><span class="text-[#00B4D8] font-bold">✓</span> Capacidad de gestión documental para ingreso industrial.</li>
          <li class="flex items-center gap-2"><span class="text-[#00B4D8] font-bold">✓</span> Personal técnico equipado y capacitado para tareas de riesgo.</li>
          <li class="flex items-center gap-2"><span class="text-[#00B4D8] font-bold">✓</span> Facturación electrónica e inscripción impositiva completa.</li>
        </ul>
      </div>
      <div class="bg-white/5 p-6 rounded-2xl border border-white/10 text-center">
        <h4 class="text-sm sm:text-base font-bold uppercase text-white mb-2">¿Representa a una gran empresa o industria?</h4>
        <p class="text-xs text-zinc-400 mb-6">Solicite nuestra Carpeta Técnica y Comercial formal.</p>
        <a href={`https://wa.me/${WSP_NUMBER}?text=${encodeURIComponent("Hola Thermotech Arg, requerimos su Carpeta Técnica/Comercial B2B.")}`} target="_blank" class="inline-block bg-[#00B4D8] hover:bg-[#0077B6] text-white font-bold text-xs uppercase tracking-wider px-6 py-3.5 rounded-xl transition w-full sm:w-auto">
          Solicitar Carpeta Comercial
        </a>
      </div>
    </div>
  </section>

  <!-- Sección de Contacto Directo Exclusiva por WhatsApp -->
  <section id="contacto-directo" class="py-16 sm:py-20 px-4 max-w-4xl mx-auto border-t border-white/5 relative z-10 text-center">
    <div class="mb-8 space-y-2">
      <span class="text-xs uppercase tracking-[0.2em] font-bold text-[#00B4D8]">Atención Comercial Directa</span>
      <h2 class="text-2xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tight text-white">¿Necesita un <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00B4D8] to-[#90E0EF]">Presupuesto?</span></h2>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-lg mx-auto">Comuníquese directamente con nuestro equipo técnico para coordinar su visita o consulta en menos de 24 horas.</p>
    </div>

    <div class="bg-white/5 p-6 sm:p-8 rounded-3xl border border-white/10 flex items-center justify-center backdrop-blur-md">
      <a href={`https://wa.me/${WSP_NUMBER}?text=${WSP_MESSAGE}`} target="_blank" class="w-full sm:w-auto bg-gradient-to-r from-green-500 to-emerald-600 hover:brightness-110 text-white font-extrabold text-xs uppercase tracking-widest px-10 py-4 rounded-xl transition flex items-center justify-center gap-2.5 shadow-[0_0_25px_rgba(34,197,94,0.3)]">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.892 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
        <span>Contactar por WhatsApp</span>
      </a>
    </div>
  </section>

  <!-- Botón Flotante WhatsApp -->
  <a href={`https://wa.me/${WSP_NUMBER}?text=${WSP_MESSAGE}`} target="_blank" class="fixed bottom-5 right-5 z-50 bg-green-600 hover:bg-green-500 text-white p-3.5 sm:p-4 rounded-full shadow-[0_0_25px_rgba(34,197,94,0.4)] transition transform hover:scale-110 flex items-center justify-center" aria-label="WhatsApp">
    <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.892 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
  </a>

  <!-- Footer -->
  <footer class="bg-[#070A13] py-8 sm:py-12 border-t border-white/5 text-center text-[11px] sm:text-xs text-zinc-500 px-4 space-y-2">
    <p class="font-bold text-zinc-300">THERMOTECH ARG - San Nicolás de los Arroyos, Buenos Aires</p>
    <p>© {new Date().getFullYear()} Thermotech Arg. Todos los derechos reservados.</p>
  </footer>

</body>
</html>